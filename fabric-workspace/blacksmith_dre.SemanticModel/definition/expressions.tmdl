/// Pasta raw dos CSVs de dataset/ no GitHub (repositório público: credencial Anonymous no serviço)
expression url_dataset = "https://raw.githubusercontent.com/alisonpezzott/dre-blacksmith/main/dataset" meta [IsParameterQuery = true, Type = "Text", IsParameterQueryRequired = true]
	lineageTag: 267968e9-5cee-46be-ab99-ed00568fd5f9

	annotation PBI_ResultType = Text

/// Lê um CSV de dataset/ com o cabeçalho e os tipos esperados; falha o refresh se algo não bater
expression ler_csv =
		(arquivo as text, tipos as list) as table =>
		let
		    // url base fixa + RelativePath: o serviço reconhece a fonte e permite o refresh agendado
		    origem = Csv.Document(
		        Web.Contents(url_dataset, [RelativePath = arquivo & ".csv"]),
		        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
		    ),
		    cabecalho = Table.PromoteHeaders(origem, [PromoteAllScalars = true]),
		    colunas = List.Transform(tipos, each _{0}),
		    // coluna ausente ou sobrando derruba o refresh em vez de carregar a tabela errada
		    conferido =
		        if List.Sort(Table.ColumnNames(cabecalho)) = List.Sort(colunas) then
		            Table.SelectColumns(cabecalho, colunas)
		        else
		            error Error.Record("ler_csv", arquivo & ".csv: cabeçalho diferente do esperado", Table.ColumnNames(cabecalho)),
		    aparado = Table.TransformColumns(conferido, List.Transform(colunas, each {_, Text.Trim, type text})),
		    tipado = Table.TransformColumnTypes(aparado, tipos, "en-US"),
		    // valor que não converte derruba o refresh em vez de virar nulo
		    linhas_com_erro = Table.RowCount(Table.SelectRowsWithErrors(tipado)),
		    resultado =
		        if linhas_com_erro = 0 then
		            tipado
		        else
		            error Error.Record("ler_csv", arquivo & ".csv: " & Text.From(linhas_com_erro) & " linha(s) com valor que não converte")
		in
		    resultado
	lineageTag: 47bad447-1d32-4fff-9d3f-2acc8aff0e29

	annotation PBI_ResultType = Function

