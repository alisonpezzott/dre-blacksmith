/// Testes de qualidade recalculados a cada refresh (substituem o antigo nb_02_qualidade).
/// Uma linha por teste: status "falha" quando |obtido - esperado| > tolerancia. Valores de referência do CLAUDE.md, seção 1.
table _qualidade

	/// Quantidade de testes com status "falha" no último refresh (esperado: 0).
	measure testes_com_falha = COUNTROWS ( FILTER ( '_qualidade', '_qualidade'[status] = "falha" ) ) + 0
		formatString: #,##0

	column ordem
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		isNameInferred
		sourceColumn: [ordem]

	column grupo
		dataType: string
		summarizeBy: none
		isNameInferred
		sourceColumn: [grupo]

	column teste
		dataType: string
		summarizeBy: none
		isNameInferred
		sourceColumn: [teste]
		sortByColumn: ordem

	column esperado
		dataType: double
		formatString: #,##0.00
		summarizeBy: none
		isNameInferred
		sourceColumn: [esperado]

	column obtido
		dataType: double
		formatString: #,##0.00
		summarizeBy: none
		isNameInferred
		sourceColumn: [obtido]

	column tolerancia
		dataType: double
		formatString: #,##0.00
		summarizeBy: none
		isNameInferred
		sourceColumn: [tolerancia]

	column diferenca
		dataType: double
		formatString: #,##0.00
		summarizeBy: none
		isNameInferred
		sourceColumn: [diferenca]

	column status
		dataType: string
		summarizeBy: none
		isNameInferred
		sourceColumn: [status]

	partition _qualidade = calculated
		mode: import
		source =
				VAR realizado = TREATAS ( { "realizado" }, 'dim_cenario'[cod_cenario] )
				VAR orcado = TREATAS ( { "orcado" }, 'dim_cenario'[cod_cenario] )
				VAR ano_2024 = TREATAS ( { 2024 }, 'dim_calendario'[ano] )
				VAR ano_2025 = TREATAS ( { 2025 }, 'dim_calendario'[ano] )
				VAR ano_2026 = TREATAS ( { 2026 }, 'dim_calendario'[ano] )
				VAR mar_2025 = TREATAS ( { "2025-03" }, 'dim_calendario'[ano_mes] )
				VAR abr_2025 = TREATAS ( { "2025-04" }, 'dim_calendario'[ano_mes] )
				-- recortes do fechamento do Sankey (entrada = saída em cada nó)
				VAR meses_cenarios =
				    CROSSJOIN ( DISTINCT ( 'dim_calendario'[indice_mes] ), DISTINCT ( 'dim_cenario'[cod_cenario] ) )
				VAR anos_cenarios =
				    CROSSJOIN ( DISTINCT ( 'dim_calendario'[ano] ), DISTINCT ( 'dim_cenario'[cod_cenario] ) )
				VAR testes =
				    UNION (
				        -- contagens do dicionário de dados
				        ROW ( "ordem", 1, "grupo", "contagens", "teste", "dim_calendario: linhas", "esperado", 36, "obtido", COUNTROWS ( 'dim_calendario' ), "tolerancia", 0 ),
				        ROW ( "ordem", 2, "grupo", "contagens", "teste", "dim_conta: linhas", "esperado", 19, "obtido", COUNTROWS ( 'dim_conta' ), "tolerancia", 0 ),
				        ROW ( "ordem", 3, "grupo", "contagens", "teste", "dim_regiao: linhas", "esperado", 5, "obtido", COUNTROWS ( 'dim_regiao' ), "tolerancia", 0 ),
				        ROW ( "ordem", 4, "grupo", "contagens", "teste", "dim_cenario: linhas", "esperado", 2, "obtido", COUNTROWS ( 'dim_cenario' ), "tolerancia", 0 ),
				        ROW ( "ordem", 5, "grupo", "contagens", "teste", "dim_no_sankey: linhas", "esperado", 30, "obtido", COUNTROWS ( 'dim_no_sankey' ), "tolerancia", 0 ),
				        ROW ( "ordem", 6, "grupo", "contagens", "teste", "dim_link_sankey: linhas", "esperado", 33, "obtido", COUNTROWS ( 'dim_link_sankey' ), "tolerancia", 0 ),
				        ROW ( "ordem", 7, "grupo", "contagens", "teste", "fato_lancamentos: linhas", "esperado", 6484, "obtido", COUNTROWS ( 'fato_lancamentos' ), "tolerancia", 0 ),
				        ROW ( "ordem", 8, "grupo", "contagens", "teste", "fato_operacional: linhas", "esperado", 180, "obtido", COUNTROWS ( 'fato_operacional' ), "tolerancia", 0 ),
				        -- chaves: sem vazio e sem duplicidade (linhas - chaves distintas não vazias)
				        ROW ( "ordem", 11, "grupo", "chaves", "teste", "dim_calendario[data] única", "esperado", 0, "obtido", COUNTROWS ( 'dim_calendario' ) - DISTINCTCOUNTNOBLANK ( 'dim_calendario'[data] ), "tolerancia", 0 ),
				        ROW ( "ordem", 12, "grupo", "chaves", "teste", "dim_calendario[indice_mes] única", "esperado", 0, "obtido", COUNTROWS ( 'dim_calendario' ) - DISTINCTCOUNTNOBLANK ( 'dim_calendario'[indice_mes] ), "tolerancia", 0 ),
				        ROW ( "ordem", 13, "grupo", "chaves", "teste", "dim_conta[cod_conta] única", "esperado", 0, "obtido", COUNTROWS ( 'dim_conta' ) - DISTINCTCOUNTNOBLANK ( 'dim_conta'[cod_conta] ), "tolerancia", 0 ),
				        ROW ( "ordem", 14, "grupo", "chaves", "teste", "dim_regiao[cod_regiao] única", "esperado", 0, "obtido", COUNTROWS ( 'dim_regiao' ) - DISTINCTCOUNTNOBLANK ( 'dim_regiao'[cod_regiao] ), "tolerancia", 0 ),
				        ROW ( "ordem", 15, "grupo", "chaves", "teste", "dim_no_sankey[cod_no] única", "esperado", 0, "obtido", COUNTROWS ( 'dim_no_sankey' ) - DISTINCTCOUNTNOBLANK ( 'dim_no_sankey'[cod_no] ), "tolerancia", 0 ),
				        ROW ( "ordem", 16, "grupo", "chaves", "teste", "dim_link_sankey[cod_link] única", "esperado", 0, "obtido", COUNTROWS ( 'dim_link_sankey' ) - DISTINCTCOUNTNOBLANK ( 'dim_link_sankey'[cod_link] ), "tolerancia", 0 ),
				        ROW ( "ordem", 17, "grupo", "chaves", "teste", "fato_lancamentos: grão mês × região × conta × cenário", "esperado", 0, "obtido", COUNTROWS ( 'fato_lancamentos' ) - COUNTROWS ( SUMMARIZE ( 'fato_lancamentos', 'fato_lancamentos'[data], 'fato_lancamentos'[cod_regiao], 'fato_lancamentos'[cod_conta], 'fato_lancamentos'[cenario] ) ), "tolerancia", 0 ),
				        ROW ( "ordem", 18, "grupo", "chaves", "teste", "fato_operacional: grão mês × região", "esperado", 0, "obtido", COUNTROWS ( 'fato_operacional' ) - COUNTROWS ( SUMMARIZE ( 'fato_operacional', 'fato_operacional'[data], 'fato_operacional'[cod_regiao] ) ), "tolerancia", 0 ),
				        -- integridade referencial (linhas órfãs)
				        ROW (
				            "ordem", 21, "grupo", "integridade", "teste", "fato_lancamentos sem data, região, conta ou cenário nas dimensões", "esperado", 0,
				            "obtido",
				                COUNTROWS (
				                    FILTER (
				                        'fato_lancamentos',
				                        ISBLANK ( RELATED ( 'dim_calendario'[data] ) )
				                            || ISBLANK ( RELATED ( 'dim_regiao'[cod_regiao] ) )
				                            || ISBLANK ( RELATED ( 'dim_conta'[cod_conta] ) )
				                            || ISBLANK ( RELATED ( 'dim_cenario'[cod_cenario] ) )
				                    )
				                ),
				            "tolerancia", 0
				        ),
				        ROW (
				            "ordem", 22, "grupo", "integridade", "teste", "fato_operacional sem data ou região nas dimensões", "esperado", 0,
				            "obtido",
				                COUNTROWS (
				                    FILTER (
				                        'fato_operacional',
				                        ISBLANK ( RELATED ( 'dim_calendario'[data] ) ) || ISBLANK ( RELATED ( 'dim_regiao'[cod_regiao] ) )
				                    )
				                ),
				            "tolerancia", 0
				        ),
				        ROW (
				            "ordem", 23, "grupo", "integridade", "teste", "dim_link_sankey: nó de origem ou destino inexistente", "esperado", 0,
				            "obtido",
				                COUNTROWS (
				                    FILTER (
				                        'dim_link_sankey',
				                        NOT ( 'dim_link_sankey'[cod_no_origem] IN VALUES ( 'dim_no_sankey'[cod_no] ) )
				                            || NOT ( 'dim_link_sankey'[cod_no_destino] IN VALUES ( 'dim_no_sankey'[cod_no] ) )
				                    )
				                ),
				            "tolerancia", 0
				        ),
				        ROW (
				            "ordem", 24, "grupo", "integridade", "teste", "dim_link_sankey: conta de link folha inexistente", "esperado", 0,
				            "obtido",
				                COUNTROWS (
				                    FILTER (
				                        'dim_link_sankey',
				                        'dim_link_sankey'[cod_conta] <> ""
				                            && NOT ( 'dim_link_sankey'[cod_conta] IN VALUES ( 'dim_conta'[cod_conta] ) )
				                    )
				                ),
				            "tolerancia", 0
				        ),
				        -- estrutura do Sankey
				        ROW (
				            "ordem", 31, "grupo", "sankey", "teste", "conta de grupo com 2+ contas sem link folha", "esperado", 0,
				            "obtido",
				                COUNTROWS (
				                    FILTER (
				                        'dim_conta',
				                        VAR grupo = 'dim_conta'[cod_grupo]
				                        VAR contas_grupo = COUNTROWS ( FILTER ( ALL ( 'dim_conta' ), 'dim_conta'[cod_grupo] = grupo ) )
				                        RETURN
				                            contas_grupo >= 2
				                                && NOT ( 'dim_conta'[cod_conta] IN VALUES ( 'dim_link_sankey'[cod_conta] ) )
				                    )
				                ),
				            "tolerancia", 0
				        ),
				        ROW (
				            "ordem", 32, "grupo", "sankey", "teste", "cod_link diferente de origem__destino", "esperado", 0,
				            "obtido",
				                COUNTROWS (
				                    FILTER (
				                        'dim_link_sankey',
				                        'dim_link_sankey'[cod_link] <> 'dim_link_sankey'[cod_no_origem] & "__" & 'dim_link_sankey'[cod_no_destino]
				                    )
				                ),
				            "tolerancia", 0
				        ),
				        ROW ( "ordem", 33, "grupo", "sankey", "teste", "fechamento dos nós: mês × cenário (maior diferença, R$)", "esperado", 0, "obtido", MAXX ( meses_cenarios, [sankey_desequilibrio_max] ), "tolerancia", 0.05 ),
				        ROW ( "ordem", 34, "grupo", "sankey", "teste", "fechamento dos nós: mês × cenário × região (maior diferença, R$)", "esperado", 0, "obtido", MAXX ( CROSSJOIN ( meses_cenarios, DISTINCT ( 'dim_regiao'[cod_regiao] ) ), [sankey_desequilibrio_max] ), "tolerancia", 0.05 ),
				        ROW ( "ordem", 35, "grupo", "sankey", "teste", "fechamento dos nós: ano × cenário (maior diferença, R$)", "esperado", 0, "obtido", MAXX ( anos_cenarios, [sankey_desequilibrio_max] ), "tolerancia", 0.05 ),
				        -- regras de sinal
				        ROW ( "ordem", 41, "grupo", "sinal", "teste", "fato_lancamentos[valor] negativo", "esperado", 0, "obtido", COUNTROWS ( FILTER ( 'fato_lancamentos', 'fato_lancamentos'[valor] < 0 ) ), "tolerancia", 0 ),
				        ROW (
				            "ordem", 42, "grupo", "sinal", "teste", "valor_dre incoerente com a natureza da conta", "esperado", 0,
				            "obtido",
				                COUNTROWS (
				                    FILTER (
				                        'fato_lancamentos',
				                        VAR natureza = RELATED ( 'dim_conta'[natureza] )
				                        RETURN
				                            ( natureza = "receita" && 'fato_lancamentos'[valor_dre] < 0 )
				                                || ( natureza = "despesa" && 'fato_lancamentos'[valor_dre] > 0 )
				                    )
				                ),
				            "tolerancia", 0
				        ),
				        -- DRE realizado consolidado (referências da seção 1)
				        ROW ( "ordem", 51, "grupo", "dre_realizado", "teste", "receita_liquida 2024", "esperado", 135461230.60, "obtido", CALCULATE ( [receita_liquida], realizado, ano_2024 ), "tolerancia", 1 ),
				        ROW ( "ordem", 52, "grupo", "dre_realizado", "teste", "receita_liquida 2025", "esperado", 154819681.80, "obtido", CALCULATE ( [receita_liquida], realizado, ano_2025 ), "tolerancia", 1 ),
				        ROW ( "ordem", 53, "grupo", "dre_realizado", "teste", "receita_liquida 2026", "esperado", 175717045.70, "obtido", CALCULATE ( [receita_liquida], realizado, ano_2026 ), "tolerancia", 1 ),
				        ROW ( "ordem", 54, "grupo", "dre_realizado", "teste", "ebitda 2024", "esperado", 28577873.76, "obtido", CALCULATE ( [ebitda], realizado, ano_2024 ), "tolerancia", 1 ),
				        ROW ( "ordem", 55, "grupo", "dre_realizado", "teste", "ebitda 2025", "esperado", 26606624.76, "obtido", CALCULATE ( [ebitda], realizado, ano_2025 ), "tolerancia", 1 ),
				        ROW ( "ordem", 56, "grupo", "dre_realizado", "teste", "ebitda 2026", "esperado", 42330126.46, "obtido", CALCULATE ( [ebitda], realizado, ano_2026 ), "tolerancia", 1 ),
				        ROW ( "ordem", 57, "grupo", "dre_realizado", "teste", "lucro_liquido 2024", "esperado", 15882255.48, "obtido", CALCULATE ( [lucro_liquido], realizado, ano_2024 ), "tolerancia", 1 ),
				        ROW ( "ordem", 58, "grupo", "dre_realizado", "teste", "lucro_liquido 2025", "esperado", 13088163.15, "obtido", CALCULATE ( [lucro_liquido], realizado, ano_2025 ), "tolerancia", 1 ),
				        ROW ( "ordem", 59, "grupo", "dre_realizado", "teste", "lucro_liquido 2026", "esperado", 24560318.22, "obtido", CALCULATE ( [lucro_liquido], realizado, ano_2026 ), "tolerancia", 1 ),
				        -- meses com prejuízo consolidado: só mar/2025 e abr/2025 no realizado, nenhum no orçado
				        ROW ( "ordem", 61, "grupo", "prejuizo", "teste", "meses com prejuízo no realizado (todos os anos)", "esperado", 2, "obtido", CALCULATE ( [meses_com_prejuizo], realizado ), "tolerancia", 0 ),
				        ROW ( "ordem", 62, "grupo", "prejuizo", "teste", "meses com prejuízo no realizado em mar e abr/2025", "esperado", 2, "obtido", CALCULATE ( [meses_com_prejuizo], realizado, TREATAS ( { "2025-03", "2025-04" }, 'dim_calendario'[ano_mes] ) ), "tolerancia", 0 ),
				        ROW ( "ordem", 63, "grupo", "prejuizo", "teste", "meses com prejuízo no orçado (todos os anos)", "esperado", 0, "obtido", CALCULATE ( [meses_com_prejuizo], orcado ), "tolerancia", 0 ),
				        -- cenários de teste do Sankey (seção 1)
				        ROW ( "ordem", 71, "grupo", "sankey_cenarios", "teste", "mar/2025: prejuizo_liquido → despesas_operacionais", "esperado", 2071798.75, "obtido", CALCULATE ( [sankey_valor], realizado, mar_2025, 'dim_link_sankey'[cod_link] = "prejuizo_liquido__despesas_operacionais" ), "tolerancia", 1 ),
				        ROW ( "ordem", 72, "grupo", "sankey_cenarios", "teste", "mar/2025: prejuizo_liquido → depreciacao_amortizacao", "esperado", 388600.04, "obtido", CALCULATE ( [sankey_valor], realizado, mar_2025, 'dim_link_sankey'[cod_link] = "prejuizo_liquido__depreciacao_amortizacao" ), "tolerancia", 1 ),
				        ROW ( "ordem", 73, "grupo", "sankey_cenarios", "teste", "mar/2025: prejuizo_liquido → resultado_financeiro_liquido", "esperado", 134368.48, "obtido", CALCULATE ( [sankey_valor], realizado, mar_2025, 'dim_link_sankey'[cod_link] = "prejuizo_liquido__resultado_financeiro_liquido" ), "tolerancia", 1 ),
				        ROW ( "ordem", 74, "grupo", "sankey_cenarios", "teste", "mar/2025: lucro_bruto → ebitda (não aparece)", "esperado", 0, "obtido", CALCULATE ( [sankey_valor], realizado, mar_2025, 'dim_link_sankey'[cod_link] = "lucro_bruto__ebitda" ), "tolerancia", 0 ),
				        ROW ( "ordem", 75, "grupo", "sankey_cenarios", "teste", "mar/2025: lair → lucro_liquido (não aparece)", "esperado", 0, "obtido", CALCULATE ( [sankey_valor], realizado, mar_2025, 'dim_link_sankey'[cod_link] = "lair__lucro_liquido" ), "tolerancia", 0 ),
				        ROW ( "ordem", 76, "grupo", "sankey_cenarios", "teste", "abr/2025: lucro_bruto → ebitda", "esperado", 20950.98, "obtido", CALCULATE ( [sankey_valor], realizado, abr_2025, 'dim_link_sankey'[cod_link] = "lucro_bruto__ebitda" ), "tolerancia", 1 ),
				        ROW ( "ordem", 77, "grupo", "sankey_cenarios", "teste", "abr/2025: prejuizo_liquido → depreciacao_amortizacao", "esperado", 345079.38, "obtido", CALCULATE ( [sankey_valor], realizado, abr_2025, 'dim_link_sankey'[cod_link] = "prejuizo_liquido__depreciacao_amortizacao" ), "tolerancia", 1 ),
				        ROW ( "ordem", 78, "grupo", "sankey_cenarios", "teste", "abr/2025: prejuizo_liquido → resultado_financeiro_liquido", "esperado", 165351.45, "obtido", CALCULATE ( [sankey_valor], realizado, abr_2025, 'dim_link_sankey'[cod_link] = "prejuizo_liquido__resultado_financeiro_liquido" ), "tolerancia", 1 ),
				        ROW ( "ordem", 79, "grupo", "sankey_cenarios", "teste", "abr/2025: prejuizo_liquido → ir_csll", "esperado", 101830.17, "obtido", CALCULATE ( [sankey_valor], realizado, abr_2025, 'dim_link_sankey'[cod_link] = "prejuizo_liquido__ir_csll" ), "tolerancia", 1 ),
				        ROW ( "ordem", 80, "grupo", "sankey_cenarios", "teste", "2025: lair → lucro_liquido", "esperado", 13088163.15, "obtido", CALCULATE ( [sankey_valor], realizado, ano_2025, 'dim_link_sankey'[cod_link] = "lair__lucro_liquido" ), "tolerancia", 1 ),
				        ROW ( "ordem", 81, "grupo", "sankey_cenarios", "teste", "2025: links saindo de prejuizo_liquido (não aparecem)", "esperado", 0, "obtido", CALCULATE ( SUMX ( 'dim_link_sankey', [sankey_valor] ), realizado, ano_2025, 'dim_link_sankey'[cod_no_origem] = "prejuizo_liquido" ), "tolerancia", 0 )
				    )
				RETURN
				    SELECTCOLUMNS (
				        testes,
				        "ordem", [ordem],
				        "grupo", [grupo],
				        "teste", [teste],
				        "esperado", [esperado] * 1.0,
				        "obtido", COALESCE ( [obtido], 0 ) * 1.0,
				        "tolerancia", [tolerancia] * 1.0,
				        "diferenca", ( COALESCE ( [obtido], 0 ) - [esperado] ) * 1.0,
				        "status", IF ( ABS ( COALESCE ( [obtido], 0 ) - [esperado] ) <= [tolerancia], "ok", "falha" )
				    )

