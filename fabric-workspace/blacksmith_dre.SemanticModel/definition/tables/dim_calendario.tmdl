	partition dim_calendario = m
		mode: import
		source =
				let
				    origem = ler_csv("dim_calendario", {
				        {"data", type date}, {"ano", Int64.Type}, {"mes", Int64.Type}, {"nome_mes", type text},
				        {"ano_mes", type text}, {"mes_ano", type text}, {"trimestre", type text},
				        {"ano_trimestre", type text}, {"semestre", type text}
				    }),
				    // índice sequencial 1..36: base das comparações com o ano anterior e dos acumulados (calendário mensal)
				    com_indice = Table.AddColumn(origem, "indice_mes", each ([ano] - 2024) * 12 + [mes], Int64.Type)
				in
				    com_indice

