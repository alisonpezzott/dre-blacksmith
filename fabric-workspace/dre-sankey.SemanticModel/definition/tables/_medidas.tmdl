	/// Variação da margem líquida contra o ano anterior, em pontos percentuais.
	measure var_margem_liquida_aa_pp =
			VAR margem_aa = [margem_liquida_aa]
			RETURN
			    IF ( NOT ISBLANK ( margem_aa ), ( [margem_liquida] - margem_aa ) * 100 )
		formatString: +0.0 \p\.\p\.;-0.0 \p\.\p\.;0.0 \p\.\p\.
		displayFolder: 03_comparativos
