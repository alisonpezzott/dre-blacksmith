	/// Valor do link selecionado em dim_link_sankey, calculado sobre os valores já agregados do filtro. A receita líquida paga cada camada de gasto em cascata; a parte não coberta vem do nó prejuizo_liquido.
	measure sankey_valor =
			VAR link = SELECTEDVALUE ( 'dim_link_sankey'[cod_link] )
			VAR conta = SELECTEDVALUE ( 'dim_link_sankey'[cod_conta] )
			VAR valor_conta =
			    IF (
			        conta <> "",
			        CALCULATE (
			            SUM ( 'fato_lancamentos'[valor] ),
			            TREATAS ( { conta }, 'dim_conta'[cod_conta] )
			        )
			    )
			-- gastos de cada camada (positivos)
			VAR g_custos = - [custos]
			VAR g_opex = - [despesas_operacionais]
			VAR g_da = - [depreciacao_amortizacao]
			VAR g_fin = - [resultado_financeiro]
			VAR g_ir = - [ir_csll]
			-- saldo disponível após cada camada (nunca negativo)
			VAR s0 = [receita_liquida]
			VAR s1 = MAX ( s0 - g_custos, 0 )
			VAR s2 = MAX ( s1 - g_opex, 0 )
			VAR s3 = MAX ( s2 - g_da, 0 )
			VAR s4 = MAX ( s3 - g_fin, 0 )
			VAR s5 = MAX ( s4 - g_ir, 0 )
			VAR resultado =
			    SWITCH (
			        link,
			        "receita_bruta__deducoes_da_receita", - [deducoes_receita],
			        "receita_bruta__receita_liquida", s0,
			        "receita_liquida__custos_cpv_csp", MIN ( s0, g_custos ),
			        "prejuizo_liquido__custos_cpv_csp", g_custos - MIN ( s0, g_custos ),
			        "receita_liquida__lucro_bruto", s1,
			        "lucro_bruto__despesas_operacionais", MIN ( s1, g_opex ),
			        "prejuizo_liquido__despesas_operacionais", g_opex - MIN ( s1, g_opex ),
			        "lucro_bruto__ebitda", s2,
			        "ebitda__depreciacao_amortizacao", MIN ( s2, g_da ),
			        "prejuizo_liquido__depreciacao_amortizacao", g_da - MIN ( s2, g_da ),
			        "ebitda__ebit_lucro_operacional", s3,
			        "ebit_lucro_operacional__resultado_financeiro_liquido", MIN ( s3, g_fin ),
			        "prejuizo_liquido__resultado_financeiro_liquido", g_fin - MIN ( s3, g_fin ),
			        "ebit_lucro_operacional__lair", s4,
			        "lair__ir_csll", MIN ( s4, g_ir ),
			        "prejuizo_liquido__ir_csll", g_ir - MIN ( s4, g_ir ),
			        "lair__lucro_liquido", s5,
			        valor_conta
			    )
			RETURN
			    IF ( resultado > 0.005, resultado )
		formatString: \R\$ #,##0;(\R\$ #,##0);-
		displayFolder: 05_sankey
		lineageTag: 71c57500-b7f7-447d-a656-a4cdb0cadd02

	/// sankey_valor dos mesmos meses do ano anterior (tooltip do app); vazio se o período não tem ano anterior completo.
	measure sankey_valor_aa =
			VAR meses = VALUES ( 'dim_calendario'[indice_mes] )
			VAR meses_aa =
			    SELECTCOLUMNS ( meses, "indice_mes", 'dim_calendario'[indice_mes] - 12 )
			VAR meses_cobertos =
			    COUNTROWS ( INTERSECT ( meses_aa, ALL ( 'dim_calendario'[indice_mes] ) ) )
			RETURN
			    IF (
			        meses_cobertos = COUNTROWS ( meses ),
			        CALCULATE (
			            [sankey_valor],
			            REMOVEFILTERS ( 'dim_calendario' ),
			            TREATAS ( meses_aa, 'dim_calendario'[indice_mes] )
			        )
			    )
		formatString: \R\$ #,##0;(\R\$ #,##0);-
		displayFolder: 05_sankey
		lineageTag: 7ca3d94c-2a81-46c4-9773-3af0cfe2cbb6

	measure var_sankey_valor_aa_pct =
			DIVIDE (
			    [sankey_valor] - [sankey_valor_aa],
			    ABS ( [sankey_valor_aa] )
			)
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 05_sankey
		lineageTag: 2d1dc8bb-e644-4eff-8315-efbad65d0b62

	measure prejuizo_liquido = MAX ( - [lucro_liquido], 0 )
		formatString: \R\$ #,##0;(\R\$ #,##0);-
		displayFolder: 05_sankey
		lineageTag: 66805786-47b0-4a55-8de0-6ab2dede4cc7

	measure meses_com_prejuizo =
			COUNTROWS (
			    FILTER ( VALUES ( 'dim_calendario'[indice_mes] ), [lucro_liquido] < 0 )
			)
		formatString: #,##0
		displayFolder: 05_sankey
		lineageTag: 6f1f368d-86b2-486b-8320-fee16289191a

	/// Momento do último refresh do modelo (horário de Brasília), independente dos filtros.
	measure data_ultima_carga = CALCULATE ( MAX ( 'fato_lancamentos'[data_hora_carga] ), REMOVEFILTERS () )
		formatString: dd/MM/yyyy HH:mm
		displayFolder: 06_carga
		lineageTag: 33413362-74a4-4c98-a137-d3fb5f539df4

	/// Maior diferença entre entrada e saída de um nó do Sankey no contexto (esperado: 0). Usada pela _qualidade e pelo report.
	measure sankey_desequilibrio_max =
			VAR links =
			    ADDCOLUMNS ( 'dim_link_sankey', "valor", [sankey_valor] )
			RETURN
			    MAXX (
			        DISTINCT ( 'dim_no_sankey'[cod_no] ),
			        VAR no = 'dim_no_sankey'[cod_no]
			        VAR entrada = SUMX ( FILTER ( links, 'dim_link_sankey'[cod_no_destino] = no ), [valor] )
			        VAR saida = SUMX ( FILTER ( links, 'dim_link_sankey'[cod_no_origem] = no ), [valor] )
			        RETURN
			            IF ( NOT ISBLANK ( entrada ) && NOT ISBLANK ( saida ), ABS ( entrada - saida ), 0 )
			    )
		formatString: \R\$ #,##0.00
		displayFolder: 07_qualidade
		lineageTag: 2b3f69fb-0c10-45b1-ac85-df647a020812

	column Value
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 1cedafcf-856f-4117-a1ff-2a05eaf5e5ca
		summarizeBy: none
		isNameInferred
		sourceColumn: [Value]

	partition _medidas = calculated
		mode: import
		source = { 0 }

