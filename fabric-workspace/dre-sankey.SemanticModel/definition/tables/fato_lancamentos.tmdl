	partition fato_lancamentos = m
		mode: import
		source =
				let
				    origem = ler_csv("fato_lancamentos", {
				        {"data", type date}, {"cod_regiao", type text}, {"cod_conta", type text}, {"cenario", type text},
				        {"valor", type number}, {"valor_dre", type number}
				    }),
				    // momento único do refresh, no horário de Brasília (sem horário de verão desde 2019): vira data_ultima_carga
				    momento_carga = DateTimeZone.RemoveZone(DateTimeZone.SwitchZone(DateTimeZone.UtcNow(), -3)),
				    com_carga = Table.AddColumn(origem, "data_hora_carga", each momento_carga, type datetime)
				in
				    com_carga

	annotation PBI_ResultType = Table

